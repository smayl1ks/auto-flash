{
  "name": "autoflash",
  "description": "AutoFlash — Modern AI Spaced Repetition Vocabulary Trainer & Obsidian Knowledge Graph",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite english_web --port 5173",
    "dev:web": "vite english_web --port 5173",
    "dev:backend": "python -m uvicorn main:app --app-dir english_backend --host 0.0.0.0 --port 8000 --reload",
    "build:css": "tailwindcss -i ./english_web/styles/input.css -o ./english_web/styles/main.css --minify",
    "watch:css": "tailwindcss -i ./english_web/styles/input.css -o ./english_web/styles/main.css --watch",
    "build": "npm run build:css && vite build english_web",
    "preview": "vite preview english_web"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "vite": "^6.0.0"
  }
}
